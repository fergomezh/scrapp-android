rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Regla global exigida: Cualquier usuario inactivo no lee ni escribe nada
    function esActivo() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().activo == true;
    }

    function esAdmin() {
      return esActivo() && perfil().rol == 'ADMINISTRADOR';
    }

    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin());

      // Flexibilizado para permitir los campos nuevos de Google (proveedor, creadoEn)
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['correo', 'rol', 'activo'])
        && request.resource.data.rol == 'OPERATIVO'
        && request.resource.data.activo == true;

      allow update: if esAdmin()
        || (esActivo()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']));

      allow delete: if esAdmin();
    }

    match /productos/{id} {
      allow read: if esActivo();
      allow write: if esAdmin();
    }

    match /lotes/{id} {
      allow read: if esActivo();

      // Operativo crea si creadoPor es su UID.
      allow create: if esAdmin() || (esActivo() && request.resource.data.creadoPor == request.auth.uid);

      // Operativo actualiza SOLO cantidadDisponible y SOLO para descontar.
      allow update: if esAdmin() || (
        esActivo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidadDisponible'])
        && request.resource.data.cantidadDisponible < resource.data.cantidadDisponible
      );
      allow delete: if esAdmin();
    }

    match /ventas/{id} {
      allow read: if esActivo();
      allow write: if esAdmin();
    }

    match /mermas/{id} {
      // El operativo lee solo sus propias mermas; el admin lee todas.
      allow read: if esAdmin() || (esActivo() && resource.data.usuarioId == request.auth.uid);

      allow create: if esActivo() && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if esAdmin();
    }

    match /configuracion/{docId} {
      allow read: if esActivo();
      allow write: if esAdmin();
    }
  }
}