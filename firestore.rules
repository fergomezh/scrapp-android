rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Regla global exigida: Cualquier usuario inactivo no lee ni escribe nada
    function esActivo() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().activo == true;
    }

    function esAdmin() {
      return esActivo() && perfil().rol == 'ADMINISTRADOR';
    }

    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin());

      // Flexibilizado para permitir los campos nuevos de Google (proveedor, creadoEn)
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['correo', 'rol', 'activo'])
        && request.resource.data.rol == 'OPERATIVO'
        && request.resource.data.activo == true;

      allow update: if esAdmin()
        || (esActivo()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']));

      allow delete: if esAdmin();
    }

    match /productos/{id} {
      allow read: if esActivo();
      allow write: if esAdmin();
    }

    match /lotes/{id} {
      allow read: if esActivo();

      // Operativo crea si creadoPor es su UID y las cantidades son coherentes
      // (no se puede crear un lote con existencia negativa o mayor a la inicial).
      allow create: if esAdmin() || (
        esActivo()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.cantidadInicial is number
        && request.resource.data.cantidadInicial > 0
        && request.resource.data.cantidadDisponible is number
        && request.resource.data.cantidadDisponible >= 0
        && request.resource.data.cantidadDisponible <= request.resource.data.cantidadInicial
      );

      // Operativo actualiza SOLO cantidadDisponible, SOLO para descontar y sin quedar en negativo.
      allow update: if esAdmin() || (
        esActivo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidadDisponible'])
        && request.resource.data.cantidadDisponible is number
        && request.resource.data.cantidadDisponible < resource.data.cantidadDisponible
        && request.resource.data.cantidadDisponible >= 0
      );
      allow delete: if esAdmin();
    }

    match /ventas/{id} {
      allow read: if esActivo();

      // Ventas simuladas para la recomendación de producción (SembradorDatos.completarVentasRecientes):
      // cualquier usuario activo puede CREAR solo documentos SIM-* marcados como SIMULADOR, nunca
      // editar ni borrar ventas, ni crear ventas reales.
      allow create: if esActivo()
        && id.matches('SIM-.*')
        && request.resource.data.creadoPor == 'SIMULADOR'
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad > 0;
      allow write: if esAdmin();
    }

    match /mermas/{id} {
      // El operativo lee solo sus propias mermas; el admin lee todas.
      allow read: if esAdmin() || (esActivo() && resource.data.usuarioId == request.auth.uid);

      // Solo a su nombre, con cantidad positiva y costo no negativo.
      allow create: if esActivo()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad > 0
        && request.resource.data.costoUnitarioCongelado is number
        && request.resource.data.costoUnitarioCongelado >= 0;
      allow update, delete: if esAdmin();
    }

    match /configuracion/{docId} {
      allow read: if esActivo();
      allow write: if esAdmin();
    }
  }
}